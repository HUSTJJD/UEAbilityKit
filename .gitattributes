# 测试素材（截图 / 录屏）走 Git LFS：mp4 / png 直接进 git 会把历史撑爆。
# 需要本机装了 git-lfs（git lfs install）才能受益；没装也不影响提交，只是文件照常入库。
docs/reports/media/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
docs/reports/media/**/*.png filter=lfs diff=lfs merge=lfs -text

# 教程素材（截图 / 录屏）同样走 LFS
docs/tutorials/media/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
docs/tutorials/media/**/*.png filter=lfs diff=lfs merge=lfs -text

# 文本结论正常入库（要能 diff）
docs/reports/*.md text eol=lf
docs/reports/*.json text eol=lf

# 教程页与清单：生成物，但要能 diff
docs/tutorials/*.md text eol=lf
docs/tutorials/*.json text eol=lf
