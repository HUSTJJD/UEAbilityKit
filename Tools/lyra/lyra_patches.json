{
	"comment": "对拷进来的 Lyra 文件打的补丁清单。原则：Lyra 有的文件一律 copy（以 Lyra 为基线）→ patch（把我们的东西加回去）。这份清单就是「source 适配层」的完整定义。",

	"source": [
		{
			"id": "ability-base",
			"file": "Source/LyraGame/AbilitySystem/Abilities/LyraGameplayAbility.h",
			"desc": "Lyra 的能力基类改为继承 UAK（继承方向：Lyra 继承 UAK）",
			"replace": [
				{
					"from": "public UGameplayAbility",
					"to": "public UAKGameplayAbility"
				}
			],
			"insert_include": "UAKGameplayAbility.h"
		},
		{
			"id": "build-dep",
			"file": "Source/LyraGame/LyraGame.Build.cs",
			"desc": "LyraGame 依赖 UEAbilityKit",
			"replace": [
				{
					"from": "\"GameplayTags\",",
					"to": "\"GameplayTags\",\n\t\t\t\"UEAbilityKit\","
				}
			]
		},
		{
			"id": "relax-native-pointer",
			"file": "Source/LyraEditor.Target.cs",
			"desc": "Lyra 把非引擎模块的裸 UObject* 成员设成报错（引擎默认是 AllowSilently，是 Lyra 自己加严的）；UAK 还没迁到 TObjectPtr，先放宽成 AllowAndLog。TODO：插件迁完 TObjectPtr 后删掉这条",
			"replace": [
				{
					"from": "NativePointerMemberBehaviorOverride = PointerMemberBehavior.Disallow;",
					"to": "NativePointerMemberBehaviorOverride = PointerMemberBehavior.AllowAndLog;"
				}
			]
		}
	],

	"uproject": {
		"desc": "整个 uproject 就是从 Lyra 拷来的，我们只往里补适配层模块与插件",
		"modules": ["LyraAdapt"],
		"plugins": ["UEAbilityKit"]
	},

	"targets": {
		"desc": "Lyra 的 Target 是基线，我们把适配层模块补进去",
		"add_modules": ["LyraAdapt"]
	},

	"config": {
		"desc": "Lyra 的 ini 是基线，我们只在末尾追加自己的段落（文件在 Tools/lyra/patches/config/）。Lyra 没有的 ini 则由这些片段直接生成。",
		"append": {
			"DefaultGame.ini": "Tools/lyra/patches/config/DefaultGame.ini.append",
			"DefaultInput.ini": "Tools/lyra/patches/config/DefaultInput.ini.append",
			"DefaultGameplayTags.ini": "Tools/lyra/patches/config/DefaultGameplayTags.ini.append",
			"DefaultUnLuaNova.ini": "Tools/lyra/patches/config/DefaultUnLuaNova.ini.append",
			"DefaultUEAbilityKit.ini": "Tools/lyra/patches/config/DefaultUEAbilityKit.ini.append"
		}
	}
}
