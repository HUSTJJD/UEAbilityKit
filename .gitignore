# 插件本地临时文件
*.autosave

# ── 从下载的 Lyra 拷进来的外围文件 ─────────────────────────────────────
# Config/ 不进仓库：Lyra 有自己的 Config，按 copy → patch 的原则由
# Tools/import_lyra 拷贝、Tools/patch_lyra.py 追加我们的段落。
# 我们真正拥有的配置只有补丁片段，在 Tools/patches/config/。
Config/

# ── Plugins/ 下只有我们自己的插件进仓库，其余全是 Lyra 拷来的 ────────────
Plugins/*
!Plugins/UEAbilityKit/
!Plugins/UnLuaNova/

# ── 从下载的 Lyra 拷进来的资产 ─────────────────────────────────────────
# 这些由 Tools/import_lyra.ps1 从你本地的 Lyra 拷贝，约 1.4 GB，不进仓库。
Plugins/GameFeatures/
Plugins/LyraExampleContent/
Plugins/LyraExtTool/
Content/ShooterCore/
Content/ShooterMaps/
*.uak.bak
*.orig

# ── 导入脚本的运行期状态（clean_lyra 会删，重新 import 会再生成）────────
Tools/.patched_files.txt
Tools/.lyra_paths.txt
Tools/.lyra_state.json
Tools/lyra_manifest.txt
# 本机专属覆盖（引擎 GUID 之类），不进仓库
Tools/lyra_patches.local.json

# ── 从 Lyra 拷来的东西：一律不进仓库，每次 import 重新生成 ───────────────
# （源码也是拷来的，同样不进——这样 git status 在导入后仍然是干净的）
/*.uproject
Source/Lyra*.Target.cs
Platforms/
Source/LyraGame/
Source/LyraEditor/

# MkDocs build output
/_site/

# Visual Studio / Rider 生成物（GenerateProjectFiles 产出，不进仓库）
*.sln
*.slnx
.vs/
.idea/
__pycache__/
