# 插件本地临时文件
*.autosave

# ── 备份与合并残留 ─────────────────────────────────────────────────────────
*.uak.bak
*.orig

# ── Plugins/ 下只有我们自己的插件进仓库 ────────────────────────────────────
Plugins/*
!Plugins/UEAbilityKit/
!Plugins/UnLuaNova/

# ── Content/：只跟踪我们自己的 UAK / Script ───────────────────────────────
# 示例工程的美术 / 音频 / 关卡体积大、不便 diff，整层忽略，
# 再用否定规则把我们真正拥有的目录放行。
Content/*
!Content/UAK/
!Content/Script/
!Content/README.md

# MkDocs build output
/_site/

# Visual Studio / Rider 生成物（GenerateProjectFiles 产出，不进仓库）
*.sln
*.slnx
.vs/
.idea/
__pycache__/
